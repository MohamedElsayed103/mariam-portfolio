---
// Source for the social preview image. scripts/og.mjs screenshots this page into public/og.png.
import '../styles/global.css';
import { person } from '../data/cv';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body>
    <div class="og" data-theme="dark">
      <svg class="net" viewBox="0 0 520 630" aria-hidden="true">
        <g fill="none" stroke="var(--line-dark)" stroke-width="2">
          <path d="M60 315H190M190 315L320 150M190 315H320M190 315L320 480M320 150H460M320 315H460M320 480H460" />
        </g>
        <g fill="var(--indigo-950)" stroke="var(--violet-300)" stroke-width="2">
          <circle cx="60" cy="315" r="16" /><circle cx="190" cy="315" r="22" />
          <rect x="296" y="126" width="48" height="48" rx="10" /><rect x="296" y="291" width="48" height="48" rx="10" /><rect x="296" y="456" width="48" height="48" rx="10" />
          <circle cx="460" cy="150" r="18" /><circle cx="460" cy="315" r="18" /><circle cx="460" cy="480" r="18" />
        </g>
        <g fill="var(--signal)">
          <circle cx="125" cy="315" r="6" /><circle cx="262" cy="224" r="6" /><circle cx="395" cy="315" r="6" /><circle cx="405" cy="480" r="6" /><circle cx="190" cy="315" r="6" />
        </g>
      </svg>
      <div class="txt">
        <p class="status"><span class="lamp"></span>{person.status}</p>
        <h1>{person.name}</h1>
        <p class="role">{person.role}. Spring Boot microservices, Cairo.</p>
      </div>
    </div>
  </body>
</html>

<style>
  body {
    background: var(--indigo-950);
  }

  .og {
    width: 1200px;
    height: 630px;
    background: var(--indigo-950);
    color: var(--on-dark);
    position: relative;
    overflow: hidden;
  }

  .net {
    position: absolute;
    right: 40px;
    top: 0;
    height: 630px;
    width: 520px;
  }

  .txt {
    position: absolute;
    left: 72px;
    bottom: 68px;
    display: grid;
    gap: 18px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 24px;
    font-weight: 550;
    color: var(--on-dark-muted);
  }

  h1 {
    font-size: 104px;
    font-weight: 800;
    font-stretch: 122%;
    letter-spacing: -0.025em;
    line-height: 0.95;
    max-width: 7ch;
  }

  .role {
    font-size: 30px;
    color: var(--on-dark-muted);
    max-width: 34ch;
    line-height: 1.25;
  }
</style>

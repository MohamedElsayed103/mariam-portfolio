---
import ProjectTelephony from './ProjectTelephony.astro';
import ProjectHospital from './ProjectHospital.astro';
import ProjectVideo from './ProjectVideo.astro';
---

<div id="projects">
  <section data-theme="light" class="intro">
    <div class="wrap">
      <h2 class="h-section">Projects</h2>
      <p class="lede">Three systems, each drawn the way it runs.</p>
    </div>
  </section>
  <ProjectTelephony />
  <ProjectHospital />
  <ProjectVideo />
</div>

<style>
  .intro {
    padding-block: var(--section) clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .intro .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 3rem;
  }
</style>

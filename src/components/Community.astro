---
import { community } from '../data/cv';
---

<section id="community" data-theme="light" class="community section-pad">
  <div class="wrap">
    <header class="community-head">
      <h2 class="h-section">I also teach.</h2>
      <p class="lede">
        Away from the codebase I teach, mentor and run workshops. These are the three places I have done it.
      </p>
    </header>

    <ul class="community-list" data-community-list>
      {
        community.map((item) => (
          <li class="row" data-community-row>
            <h3 class="row-role">{item.role}</h3>
            <div class="row-detail">
              <p class="row-org">{item.org}</p>
              <p class="row-text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .community-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 0.6rem + 1.5vw, 1.75rem);
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .community-list {
    border-bottom: 1px solid var(--rule);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(1.75rem, 1.2rem + 2.2vw, 2.9rem);
  }

  /* The rule is drawn, not printed: it scales from the left as the row arrives. */
  .row::before,
  .row::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    transform-origin: 0 50%;
  }

  .row::before {
    background: var(--rule);
    transform: scaleX(var(--draw, 1));
  }

  .row::after {
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .row-role {
    font-size: clamp(1.5rem, 1.1rem + 1.75vw, 2.5rem);
    font-weight: 720;
    font-stretch: 112%;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: color var(--dur-2) var(--ease-out);
  }

  .row-detail {
    display: grid;
    gap: 0.45rem;
    max-width: 44ch;
  }

  .row-org {
    font-weight: 620;
    line-height: 1.4;
  }

  .row-text {
    color: var(--fg-muted);
    line-height: 1.55;
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover::after {
      transform: scaleX(1);
    }

    .row:hover .row-role {
      color: var(--accent);
    }
  }

  @media (min-width: 56rem) {
    .community-head,
    .row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .community-head {
      align-items: end;
      align-items: last baseline;
    }

    .community-head .h-section {
      grid-column: 1 / span 7;
    }

    /* Lede and row details share one axis down the page. */
    .community-head .lede,
    .row-detail {
      grid-column: 8 / -1;
    }

    .row {
      align-items: baseline;
    }

    .row-role {
      grid-column: 1 / span 6;
    }
  }
</style>

<script>
  import { gsap, reduced, EASE, whenVisible } from '../scripts/motion';

  const rows = document.querySelectorAll<HTMLElement>('[data-community-row]');

  if (rows.length && !reduced) {
    rows.forEach((row) => {
      const role = row.querySelector<HTMLElement>('.row-role');
      const detail = row.querySelectorAll<HTMLElement>('.row-detail > *');

      whenVisible(
        row,
        () => {
          const tl = gsap.timeline();
          // Rule first, then the role is uncovered along it, then the detail settles.
          tl.fromTo(row, { '--draw': 0 }, { '--draw': 1, duration: 1.1, ease: EASE.inOut }, 0);
          if (role) {
            tl.fromTo(
              role,
              { clipPath: 'inset(-0.2em 100% -0.2em 0)' },
              {
                clipPath: 'inset(-0.2em 0% -0.2em 0)',
                duration: 1.1,
                ease: EASE.quart,
                clearProps: 'clipPath',
              },
              0.3,
            );
          }
          tl.from(
            detail,
            { opacity: 0, y: 14, duration: 0.8, stagger: 0.09, ease: EASE.out, clearProps: 'opacity,transform' },
            0.55,
          );
        },
        'top 86%',
      );
    });
  }
</script>

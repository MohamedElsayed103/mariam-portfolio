---
import { nav, person } from '../data/cv';
---

<header class="nav" data-nav data-theme="dark">
  <div class="bar">
    <div class="wrap bar-in">
      <a class="monogram" href="#top" aria-label={`${person.name}, back to top`}>{person.initials}</a>

      <nav class="links" aria-label="Primary">
        <ul>
          {
            nav.map((link) => (
              <li>
                <a href={link.href} data-nav-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="cv" href={person.cv} download aria-label="Download CV, PDF">
          CV
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M8 2v9M4 7.5 8 11.5l4-4M3 14h10" />
          </svg>
        </a>
      </nav>

      <button class="toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
        <span data-nav-toggle-label>Menu</span>
        <span class="toggle-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
    <span class="trace" aria-hidden="true"><span class="trace-fill" data-nav-trace></span></span>
  </div>

  <div class="menu" id="nav-menu" data-theme="dark" data-nav-menu data-lenis-prevent>
    <div class="wrap menu-in">
      <nav aria-label="Menu">
        <ul class="menu-list">
          {
            nav.map((link, i) => (
              <li style={`--i:${i}`}>
                <a href={link.href} data-nav-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-foot" style={`--i:${nav.length}`}>
        <p class="menu-status"><span class="lamp"></span>{person.status}</p>
        <ul class="menu-meta">
          <li><a href={person.cv} download>Download CV</a></li>
          <li><a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={person.github} target="_blank" rel="noopener">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: var(--z-nav);
    color: var(--fg);
  }

  .bar {
    position: relative;
    z-index: 2;
    height: 100%;
    background: var(--bg);
    color: var(--fg);
    transition:
      transform var(--dur-3) var(--ease-out),
      background-color 240ms var(--ease-quart),
      color 240ms var(--ease-quart);
  }

  /* Hidden on scroll down. The 2px trace stays on screen as a reading-progress line. */
  .nav[data-hidden] .bar {
    transform: translateY(calc(-100% + 2px));
  }

  .bar-in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .monogram {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    font-size: 1.3rem;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .links ul {
    display: flex;
    align-items: center;
  }

  .links ul a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1;
    text-decoration: none;
    color: var(--fg-muted);
    transition: color var(--dur-2) var(--ease-out);
  }

  .links ul a:hover,
  .links ul a[aria-current] {
    color: var(--fg);
  }

  /* The lamp of the section you are in. */
  .links ul a::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: -0.1875rem;
    border-radius: 50%;
    background: var(--lamp);
    transform: scale(0);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .links ul a[aria-current]::before {
    transform: scale(1);
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.75rem;
    padding-inline: 1.05rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--rule);
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    transition:
      box-shadow var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .cv svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .cv:hover {
    background: var(--fg);
    color: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--fg);
  }

  .cv:hover svg {
    transform: translateY(2px);
  }

  .trace {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    overflow: hidden;
  }

  .trace-fill {
    display: block;
    height: 100%;
    background: var(--lamp);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .nav[data-open] .trace {
    visibility: hidden;
  }

  /* ---------- Menu button ---------- */
  .toggle {
    display: none;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    padding-inline: 1.05rem 0.95rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1.5px var(--rule);
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1;
  }

  .toggle-icon {
    position: relative;
    width: 1.05rem;
    height: 0.75rem;
  }

  .toggle-icon i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .toggle-icon i:first-child {
    top: 1px;
  }

  .toggle-icon i:last-child {
    bottom: 1px;
  }

  .toggle[aria-expanded='true'] .toggle-icon i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .toggle[aria-expanded='true'] .toggle-icon i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---------- Full-screen menu ---------- */
  .menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: var(--nav-h);
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 420ms var(--ease-in-out),
      visibility 0s linear 420ms;
  }

  .nav[data-open] .menu {
    visibility: visible;
    clip-path: inset(0);
    transition:
      clip-path var(--dur-3) var(--ease-out),
      visibility 0s;
  }

  .menu-in {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: clamp(1.25rem, 5vh, 3rem) max(1.75rem, env(safe-area-inset-bottom));
  }

  .menu-list li,
  .menu-foot {
    opacity: 0;
    transform: translateY(1.4rem);
    transition:
      opacity var(--dur-1) linear,
      transform 0s linear 420ms;
  }

  .nav[data-open] .menu-list li,
  .nav[data-open] .menu-foot {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-3) var(--ease-out) calc(140ms + var(--i) * 55ms),
      transform 800ms var(--ease-out) calc(140ms + var(--i) * 55ms);
  }

  .menu-list a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
    padding-block: 0.12em;
    font-size: clamp(1.75rem, min(1.2rem + 6.4vw, 9.5vh), 4rem);
    font-weight: 750;
    font-stretch: 116%;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-decoration: none;
    color: var(--fg);
  }

  .menu-list a::after {
    content: '';
    width: 0.24em;
    height: 0.24em;
    border-radius: 50%;
    background: var(--lamp);
    transform: scale(0);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .menu-list a[aria-current]::after {
    transform: scale(1);
  }

  .menu-foot {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .menu-status {
    display: flex;
    align-items: center;
    gap: 0.6em;
    color: var(--fg-muted);
  }

  .menu-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  .menu-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  @media (max-width: 51.24em) {
    .menu {
      display: block;
    }

    /* Without JS the links stay reachable as a scrollable row. */
    .links {
      overflow-x: auto;
    }

    .links ul a {
      padding-inline: 0.7rem;
    }

    .nav[data-ready] .links {
      display: none;
    }

    .nav[data-ready] .toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  import { getLenis } from '../scripts/motion';

  function initNav() {
    const header = document.querySelector<HTMLElement>('[data-nav]');
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const toggleLabel = header.querySelector<HTMLElement>('[data-nav-toggle-label]');
    const trace = header.querySelector<HTMLElement>('[data-nav-trace]');
    const menu = header.querySelector<HTMLElement>('[data-nav-menu]');
    if (!toggle || !menu) return;

    const root = document.documentElement;
    const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const ids = [...new Set(links.map((a) => a.hash.slice(1)))];
    const themed = [...document.querySelectorAll<HTMLElement>('section[data-theme], footer[data-theme]')];
    const narrow = window.matchMedia('(max-width: 51.24em)');

    let open = false;
    let lastY = window.scrollY;
    let theme = header.dataset.theme ?? 'dark';
    let activeId: string | null = null;
    let ticking = false;

    header.setAttribute('data-ready', '');

    const setTheme = (next: string) => {
      if (next === theme) return;
      theme = next;
      header.dataset.theme = next;
    };

    const setActive = (id: string | null) => {
      if (id === activeId) return;
      activeId = id;
      for (const a of links) {
        if (id && a.hash === `#${id}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const vh = window.innerHeight;
      const max = Math.max(1, root.scrollHeight - vh);

      if (trace) trace.style.transform = `scaleX(${Math.min(1, Math.max(0, y / max)).toFixed(4)})`;

      // Which themed block sits under the bar.
      if (!open) {
        const probe = header.offsetHeight / 2;
        let under: string | undefined;
        for (const el of themed) {
          const r = el.getBoundingClientRect();
          if (r.top <= probe && r.bottom > probe) under = el.dataset.theme;
        }
        if (under) setTheme(under);
      }

      // Which nav target is being read.
      const line = vh * 0.4;
      let current: string | null = null;
      let lastPresent: string | null = null;
      for (const id of ids) {
        const el = document.getElementById(id);
        if (!el) continue;
        lastPresent = id;
        const r = el.getBoundingClientRect();
        if (r.top <= line && r.bottom > line) current = id;
      }
      if (lastPresent && y > 0 && y >= max - 2) {
        const el = document.getElementById(lastPresent);
        if (el && el.getBoundingClientRect().top < vh) current = lastPresent;
      }
      setActive(current);

      // Hide going down, show going up. Never while the keyboard is inside the bar.
      const delta = y - lastY;
      if (open || y < header.offsetHeight * 1.5 || header.querySelector(':focus-visible')) {
        header.removeAttribute('data-hidden');
      } else if (delta > 6) {
        header.setAttribute('data-hidden', '');
      } else if (delta < -6) {
        header.removeAttribute('data-hidden');
      }
      if (Math.abs(delta) > 6) lastY = y;
    };

    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const setOpen = (next: boolean, restoreFocus = true) => {
      if (next === open) return;
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      if (toggleLabel) toggleLabel.textContent = next ? 'Close' : 'Menu';
      header.toggleAttribute('data-open', next);
      if (next) {
        header.removeAttribute('data-hidden');
        setTheme('dark');
        getLenis()?.stop();
        root.style.overflow = 'hidden';
        menu.scrollTop = 0;
      } else {
        getLenis()?.start();
        root.style.overflow = '';
        if (restoreFocus) toggle.focus();
        request();
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));

    for (const a of menu.querySelectorAll('a')) {
      // Runs before Lenis sees the click, so scrolling is unlocked in time for the anchor jump.
      a.addEventListener('click', () => setOpen(false, false));
    }

    header.addEventListener('keydown', (e) => {
      if (!open) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const stops = [...header.querySelectorAll<HTMLElement>('a[href], button')].filter(
        (el) => el.getClientRects().length > 0,
      );
      if (!stops.length) return;
      const first = stops[0];
      const last = stops[stops.length - 1];
      const at = document.activeElement;
      if (e.shiftKey && (at === first || !header.contains(at))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (at === last || !header.contains(at))) {
        e.preventDefault();
        first.focus();
      }
    });

    header.addEventListener('focusin', () => {
      if (header.querySelector(':focus-visible')) header.removeAttribute('data-hidden');
    });

    narrow.addEventListener('change', (e) => {
      if (!e.matches) setOpen(false, false);
    });

    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    window.addEventListener('load', request);
    update();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initNav);
  else initNav();
</script>

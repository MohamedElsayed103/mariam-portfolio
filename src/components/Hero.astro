---
import { person } from '../data/cv';
import { NODES, EDGES } from '../scripts/hero-system';

const nameLines = person.name.split(' ');
const pts = (list: [number, number][]) => list.map((p) => p.join(',')).join(' ');
const queueLabels = EDGES.filter((e) => e.label).map((e) => {
  // Sit the label on the last straight run of the edge.
  const [a, b] = e.wide.slice(-2);
  return { text: e.label, x: (a[0] + b[0]) / 2, y: b[1] };
});
---

<script is:inline>
  // Hide the pieces the load sequence reveals, before first paint. CSS brings them back if the module never runs.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('hero-pre');
</script>

<section id="top" data-theme="dark" class="hero" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-status" data-in="meta">
        <span class="pill"><span class="lamp"></span>{person.status}</span>
        <span class="place">{person.location}</span>
      </p>

      <h1 class="hero-name" aria-label={person.name}>
        {nameLines.map((line) => (
          <span class="line" aria-hidden="true"><span class="line-in" data-in="line">{line}</span></span>
        ))}
      </h1>

      <p class="hero-headline" data-in="copy">{person.headline}</p>
      <p class="hero-intro" data-in="copy">{person.intro}</p>

      <div class="hero-actions" data-in="copy">
        <a class="btn btn-signal" href="#contact">Get in touch</a>
        <a class="btn btn-ghost" href={person.cv} download>
          Download CV
          <svg class="dl" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M8 2v8.5M4.5 7.5 8 11l3.5-3.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero-sys" data-sys>
      <div
        class="sys-stage"
        data-sys-stage
        role="group"
        aria-label="Live system diagram. Press a node to send a request to it."
      >
        <p class="sr-only">
          A client calls a gateway. The gateway reads from Redis and forwards requests to appointment-service, which
          stores data in PostgreSQL and publishes events to RabbitMQ. workflow_service consumes statusQueue and
          notification_service consumes appointmentQueue. Small packets show requests, responses and queued messages
          moving between them.
        </p>

        <svg class="sys-static sys-static--wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {EDGES.map((e) => <polyline class={`sys-edge sys-edge--${e.kind}`} points={pts(e.wide)} />)}
        </svg>
        <svg class="sys-static sys-static--compact" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {EDGES.filter((e) => e.compact).map((e) => <polyline class={`sys-edge sys-edge--${e.kind}`} points={pts(e.compact!)} />)}
        </svg>

        {queueLabels.map((q) => (
          <span class="sys-queue code" style={`--x:${q.x};--y:${q.y}`} data-in="label" aria-hidden="true">{q.text}</span>
        ))}

        {NODES.map((n) => (
          <button
            type="button"
            class={`node node--${n.kind}${n.compact ? '' : ' node--wide-only'}`}
            data-node={n.id}
            data-in="node"
            aria-label={`Send a request to ${n.label}`}
            style={`--x:${n.wide[0]};--y:${n.wide[1]};--cx:${(n.compact ?? n.wide)[0]};--cy:${(n.compact ?? n.wide)[1]}`}
          >
            <span class="node-lamp" aria-hidden="true"></span>
            <span class:list={['node-label', { code: n.kind !== 'infra' }]}>{n.label}</span>
            {n.id === 'rabbit' && <span class="node-q" aria-hidden="true"><i></i><i></i><i></i></span>}
          </button>
        ))}
      </div>

      <div class="sys-bar" data-in="bar">
        <button type="button" class="sys-send" data-send>
          <span class="sys-send-key" aria-hidden="true"></span>
          Send a request
        </button>
        <p class="sys-readout" data-readout data-state="idle" role="status" aria-live="polite">
          <span class="rd-top">
            <span class="code rd-status" data-rd-status></span>
            <span class="code rd-ms" data-rd-ms></span>
          </span>
          <span class="rd-route" data-rd-route>Or press any node to route a request to it.</span>
        </p>
        <ul class="sys-legend" aria-hidden="true">
          <li><span class="key key--req"></span>request</li>
          <li><span class="key key--msg"></span>queued message</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduced, EASE } from '../scripts/motion';
  import { createHeroSystem } from '../scripts/hero-system';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const sysRoot = hero?.querySelector<HTMLElement>('[data-sys]');

  if (hero && sysRoot) {
    const sys = createHeroSystem(sysRoot, { reduced });
    const html = document.documentElement;

    if (reduced || !sys) {
      html.classList.remove('hero-pre');
      sys?.start();
    } else {
      const q = (name: string) => hero.querySelectorAll<HTMLElement>(`[data-in="${name}"]`);
      const edges = sys.edgePaths();
      edges.forEach((p) => {
        p.setAttribute('pathLength', '1');
        p.style.strokeDasharray = '1';
      });

      // One sequence: name, copy, wiring, nodes, then traffic.
      html.classList.remove('hero-pre');
      const tl = gsap.timeline({ defaults: { ease: EASE.out } });
      tl.from(q('line'), { yPercent: 108, duration: 1, stagger: 0.09 }, 0)
        .from(q('meta'), { opacity: 0, duration: 0.6 }, 0.1)
        .from(q('copy'), { opacity: 0, y: 18, duration: 0.8, stagger: 0.08 }, 0.3)
        .fromTo(edges, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.8, stagger: 0.05, ease: EASE.inOut }, 0.25)
        .from(q('node'), { opacity: 0, scale: 0.9, duration: 0.5, stagger: 0.045, clearProps: 'transform,opacity' }, 0.75)
        .from(q('label'), { opacity: 0, duration: 0.6 }, 1.1)
        .from(q('bar'), { opacity: 0, duration: 0.6 }, 1.1)
        .add(() => {
          edges.forEach((p) => {
            p.removeAttribute('pathLength');
            p.style.strokeDasharray = '';
            p.style.strokeDashoffset = '';
          });
          sys.start();
        }, 1.35);

      // Leaving the hero: the diagram recedes a little faster than the page.
      // Side by side only: when stacked, the diagram is what the visitor is scrolling towards.
      gsap.matchMedia().add('(min-width: 1180px)', () => {
        gsap.to(sysRoot, {
          yPercent: -7,
          opacity: 0.2,
          ease: 'none',
          scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
        });
      });
      ScrollTrigger.refresh();
    }
  }
</script>

<style>
  .hero {
    min-height: 100svh;
    padding-top: var(--nav-h);
    display: grid;
    overflow: clip;
    background:
      radial-gradient(120% 90% at 78% 38%, color-mix(in oklch, var(--indigo-800) 55%, transparent), transparent 62%),
      var(--bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    row-gap: clamp(2rem, 1rem + 4vw, 3.5rem);
    padding-block: clamp(1.25rem, 0.5rem + 3vw, 2.5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  /* ---------- Copy ---------- */
  .hero-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: var(--text-sm);
    line-height: 1.2;
    margin-bottom: clamp(1.1rem, 0.6rem + 1.6vw, 2rem);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.9em 0.5em 0.75em;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--rule);
    font-weight: 550;
  }

  .pill .lamp {
    box-shadow: 0 0 0 0.22em color-mix(in oklch, var(--lamp) 22%, transparent);
  }

  .place {
    color: var(--fg-muted);
  }

  .hero-name {
    font-size: clamp(3.1rem, 1.55rem + 6.6vw, 6rem);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.025em;
    line-height: 0.94;
  }

  .line {
    display: block;
    overflow: clip;
    /* room for the mask so nothing is shaved off the caps */
    padding-block: 0.04em;
  }

  .line-in {
    display: block;
    will-change: transform;
  }

  .hero-headline {
    margin-top: clamp(1rem, 0.7rem + 1vw, 1.6rem);
    font-size: var(--text-xl);
    font-weight: 600;
    font-stretch: 106%;
    line-height: 1.16;
    letter-spacing: -0.012em;
    max-width: 17ch;
    text-wrap: balance;
  }

  .hero-intro {
    margin-top: clamp(0.7rem, 0.5rem + 0.6vw, 1.1rem);
    color: var(--fg-muted);
    max-width: 42ch;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.3rem, 0.9rem + 1.4vw, 2.1rem);
  }

  .dl {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .btn:hover .dl {
    transform: translateY(2px);
  }

  /* ---------- System ---------- */
  .hero-sys {
    position: relative;
    container: sys / inline-size;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .sys-stage {
    position: relative;
    height: clamp(21rem, 14rem + 22vw, 27rem);
    font-size: 0.8125rem;
  }

  .sys-static,
  :global(.sys-live) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .sys-static--compact,
  .sys-stage:global(.is-live) .sys-static {
    display: none;
  }

  .sys-static :global(.sys-edge) {
    vector-effect: non-scaling-stroke;
  }

  .sys-stage :global(.sys-edge) {
    fill: none;
    stroke: color-mix(in oklch, var(--violet-400) 62%, var(--indigo-950));
    stroke-width: 1;
    transition: stroke var(--dur-3) var(--ease-out);
  }

  .sys-stage :global(.sys-edge--amqp) {
    stroke-dasharray: 2 5;
  }

  .sys-stage :global(.sys-edge.is-route) {
    stroke: var(--violet-200);
  }

  .sys-stage :global(.sys-pk) {
    fill: none;
    stroke: var(--signal);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .sys-stage :global(.sys-pk--res) {
    stroke-width: 2.5;
    opacity: 0.62;
  }

  .sys-stage :global(.sys-pk--msg) {
    stroke: var(--flare);
  }

  .sys-stage :global(.sys-pk.is-user) {
    stroke-width: 4;
  }

  /* Nodes: real buttons sitting on the wiring. */
  .node {
    --near: 0;
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    height: 2.25rem;
    padding: 0 0.8em 0 0.7em;
    white-space: nowrap;
    line-height: 1;
    color: var(--fg);
    background: var(--indigo-900);
    border-radius: var(--r-sm);
    box-shadow: inset 0 0 0 1px
      color-mix(in oklch, var(--violet-300) calc(var(--near) * 70%), color-mix(in oklch, var(--violet-400) 55%, var(--indigo-900)));
    transition:
      background-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  /* 44px touch target without changing the drawn size */
  .node::after {
    content: '';
    position: absolute;
    inset: -0.3rem -0.1rem;
  }

  .node--infra {
    border-radius: var(--r-pill);
    padding-inline: 0.85em 1em;
    font-weight: 600;
    font-size: 1.04em;
  }

  .node--edge {
    background: var(--indigo-950);
  }

  .node .code {
    font-size: 1em;
  }

  .node:hover,
  .node:focus-visible,
  .node:global(.is-route) {
    background: var(--indigo-800);
    box-shadow: inset 0 0 0 1px var(--violet-200);
  }

  .node:active {
    background: var(--indigo-700);
  }

  .node-lamp {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: none;
    background: var(--signal);
    opacity: calc(0.55 + var(--near) * 0.3);
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--signal) 0%, transparent);
    transition:
      opacity 620ms var(--ease-out),
      box-shadow 620ms var(--ease-out);
  }

  .node:global(.is-hit) .node-lamp {
    opacity: 1;
    box-shadow: 0 0 0 0.28rem color-mix(in oklch, var(--signal) 26%, transparent);
    transition-duration: 50ms;
  }

  /* RabbitMQ shows what is waiting on the queue. */
  .node-q {
    display: inline-flex;
    gap: 2px;
    margin-left: 0.15em;
  }

  .node-q i {
    width: 5px;
    height: 10px;
    border-radius: 1px;
    background: color-mix(in oklch, var(--violet-400) 40%, var(--indigo-900));
    transition: background-color var(--dur-1) linear;
  }

  .node:global([data-q='1']) .node-q i:nth-child(-n + 1),
  .node:global([data-q='2']) .node-q i:nth-child(-n + 2),
  .node:global([data-q='3']) .node-q i:nth-child(-n + 3) {
    background: var(--flare);
  }

  .sys-queue {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    /* clear of the node tops, centred over the queue's run */
    translate: -50% calc(-100% - 1.6rem);
    font-size: 0.75rem;
    line-height: 1;
    color: var(--fg-muted);
    white-space: nowrap;
    pointer-events: none;
    display: none;
  }

  /* Control bar */
  .sys-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    min-height: 3rem;
  }

  .sys-send {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    min-height: 2.75rem;
    padding: 0 1em 0 0.85em;
    border-radius: var(--r-sm);
    background: var(--indigo-800);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--violet-400) 70%, var(--indigo-900));
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .sys-send:hover {
    background: var(--indigo-700);
    box-shadow: inset 0 0 0 1px var(--violet-200);
  }

  .sys-send:active {
    transform: scale(0.97);
  }

  .sys-send-key {
    width: 0.9rem;
    height: 3px;
    border-radius: 2px;
    background: var(--signal);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .sys-send:hover .sys-send-key {
    transform: translateX(3px);
  }

  .sys-readout {
    flex: 1 1 14rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .rd-top {
    display: flex;
    gap: 1.1em;
    font-size: 1rem;
  }

  .sys-readout[data-state='idle'] .rd-top {
    display: none;
  }

  .rd-status {
    color: var(--signal);
  }

  .sys-readout[data-state='pending'] .rd-status {
    color: var(--fg-muted);
  }

  .rd-ms {
    color: var(--fg);
  }

  .rd-route {
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }

  .sys-readout:not([data-state='idle']) .rd-route {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-ligatures: none;
  }

  .sys-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-size: 0.75rem;
    line-height: 1;
    color: var(--fg-muted);
  }

  .sys-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .key {
    width: 10px;
    height: 3px;
    border-radius: 2px;
    background: var(--signal);
  }

  .key--msg {
    background: var(--flare);
  }

  /* Narrow stage: fewer nodes, stacked rows. Keep 560px in sync with COMPACT_BELOW. */
  @container sys (max-width: 559.98px) {
    .sys-stage {
      height: 16rem;
      font-size: 0.75rem;
    }

    .node {
      left: calc(var(--cx) * 1%);
      top: calc(var(--cy) * 1%);
      padding-inline: 0.65em 0.7em;
      gap: 0.5em;
    }

    .node--wide-only,
    .sys-static--wide {
      display: none;
    }

    .sys-static--compact {
      display: block;
    }
  }

  @container sys (min-width: 700px) {
    .sys-stage {
      font-size: 0.875rem;
    }

    .sys-queue {
      display: block;
    }

    /* The top-right corner of the wide layout is free: the key lives there and the route gets a full line. */
    .sys-legend {
      position: absolute;
      top: 0.25rem;
      right: 0;
    }
  }

  /* Tablet: the name runs on one line and the two paragraphs share a row. */
  @media (min-width: 700px) and (max-width: 1179.98px) {
    .hero-copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2rem;
      align-items: start;
    }

    .hero-status,
    .hero-name,
    .hero-actions {
      grid-column: 1 / -1;
    }

    .hero-name {
      font-size: min(6rem, 9.2vw);
      white-space: nowrap;
    }

    .line {
      display: inline-block;
      vertical-align: top;
    }

    .line + .line {
      margin-left: 0.24em;
    }

    .hero-headline,
    .hero-intro {
      margin-top: clamp(1.4rem, 0.6rem + 2vw, 2rem);
    }

    .hero-intro {
      /* first line sits on the headline's first line */
      padding-top: 0.2em;
    }
  }

  /* Desktop: copy anchors bottom-left, the system takes the rest of the room. */
  @media (min-width: 1180px) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-content: stretch;
      column-gap: clamp(1.5rem, 3vw, 3.5rem);
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
    }

    .hero-status {
      margin-bottom: auto;
      padding-bottom: 2rem;
    }

    .hero-sys {
      gap: 1.25rem;
    }

    .sys-stage {
      flex: 1;
      height: auto;
      min-height: 24rem;
    }
  }

  /* Load sequence: hidden until the script takes over, shown anyway if it never does. */
  :global(.hero-pre) .hero [data-in] {
    opacity: 0;
    animation: hero-show 0.4s 3.5s forwards;
  }

  :global(.hero-pre) .hero [data-in='line'] {
    opacity: 1;
    transform: translateY(108%);
    animation-name: hero-line;
  }

  :global(.hero-pre) .hero .sys-static {
    opacity: 0;
  }

  @keyframes hero-line {
    to {
      transform: none;
    }
  }

  @keyframes hero-show {
    to {
      opacity: 1;
    }
  }
</style>
